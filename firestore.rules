rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /*
     * ============================================================
     * Autenticação e autorização
     * ============================================================
     */

    function estaAutenticado() {
      return request.auth != null;
    }

    function possuiUsuarioProvisionado() {
      return estaAutenticado()
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        );
    }

    function usuarioAtual() {
      return get(
        /databases/$(database)/documents/usuarios/$(request.auth.uid)
      ).data;
    }

    function usuarioEstaAtivo() {
      return possuiUsuarioProvisionado()
        && usuarioAtual().ativo == true;
    }

    function possuiPerfil(perfil) {
      return usuarioEstaAtivo()
        && usuarioAtual().perfis is list
        && perfil in usuarioAtual().perfis;
    }

    function ehAdmin() {
      return possuiPerfil("ADMIN");
    }

    function possuiAcessoOperacional() {
      return possuiPerfil("ADMIN")
        || possuiPerfil("OPERADOR");
    }


    /*
     * ============================================================
     * Validação de perfis
     * ============================================================
     */

    function perfisReconhecidosSemDuplicidade(perfis) {
      return perfis is list
        && perfis.size() <= 2
        && perfis.toSet().size() == perfis.size()
        && perfis.toSet().hasOnly([
          "ADMIN",
          "OPERADOR"
        ]);
    }

    function perfisValidosParaEstado(ativo, perfis) {
      return perfisReconhecidosSemDuplicidade(perfis)
        && (
          ativo == false
          || perfis.size() >= 1
        );
    }


    /*
     * ============================================================
     * Validações de usuarios/{uid}
     * ============================================================
     */

    function estadoAdministrativoUsuarioValido(data) {
      return data.ativo is bool
        && perfisValidosParaEstado(
          data.ativo,
          data.perfis
        )
        && data.atualizadoEm is timestamp
        && data.atualizadoPor is string
        && data.ultimaOperacaoId is string
        && data.ultimaOperacaoId.size() > 0;
    }

    function camposAlteradosUsuarioPermitidos(before, after) {
      return after
        .diff(before)
        .affectedKeys()
        .hasOnly([
          "ativo",
          "perfis",
          "atualizadoEm",
          "atualizadoPor",
          "ultimaOperacaoId"
        ]);
    }

    function metadadosForamAtualizados(before, after) {
	  return after
		.diff(before)
		.affectedKeys()
		.hasAll([
		  "atualizadoEm",
		  "ultimaOperacaoId"
		]);
	}

    function houveAlteracaoAdministrativaReal(before, after) {
      return before.ativo != after.ativo
        || before.perfis != after.perfis;
    }

    function metadadosAdministrativosValidos(after) {
      return after.atualizadoEm == request.time
        && after.atualizadoPor == request.auth.uid
        && after.ultimaOperacaoId is string
        && after.ultimaOperacaoId.size() > 0;
    }

    /*
     * S4-DEC-003
     *
     * Se o ADMIN alterar o próprio documento, o estado posterior
     * deverá continuar:
     *
     * ativo == true
     * +
     * perfil ADMIN presente
     */
    function autoprotecaoAdminValida(usuarioId, after) {
      return usuarioId != request.auth.uid
        || (
          after.ativo == true
          && "ADMIN" in after.perfis
        );
    }

    function alteracaoAdministrativaUsuarioBaseValida(
      usuarioId,
      before,
      after
    ) {
      return ehAdmin()
        && estadoAdministrativoUsuarioValido(after)
        && camposAlteradosUsuarioPermitidos(
          before,
          after
        )
        && metadadosForamAtualizados(
          before,
          after
        )
        && houveAlteracaoAdministrativaReal(
          before,
          after
        )
        && metadadosAdministrativosValidos(after)
        && autoprotecaoAdminValida(
          usuarioId,
          after
        );
    }

	/*
     * ============================================================
     * Validações de alunos/{alunoId}
     * ============================================================
     */

    function estadoAlunoValido(data) {
      return data.keys().hasAll([
          "nome",
          "faixa",
          "matricula",
          "ativo",
          "atualizadoEm",
          "atualizadoPor",
          "ultimaOperacaoId"
        ])
        && data.keys().hasOnly([
          "nome",
          "faixa",
          "matricula",
          "ativo",
          "atualizadoEm",
          "atualizadoPor",
          "ultimaOperacaoId"
        ])
        && data.nome is string
        && data.nome.size() > 0
        && data.faixa is string
        && data.faixa.size() > 0
        && data.matricula is string
        && data.matricula.matches('^[0-9]{6}$')
        && data.matricula != "000000"
        && data.ativo is bool
        && data.atualizadoEm is timestamp
        && data.atualizadoPor is string
        && data.atualizadoPor.size() > 0
        && data.ultimaOperacaoId is string
        && data.ultimaOperacaoId.size() > 0;
    }

    function camposAdministraveisAlunoAlterados(before, after) {
      return before.nome != after.nome
        || before.faixa != after.faixa
        || before.ativo != after.ativo;
    }

    function matriculaAlunoPermaneceImutavel(before, after) {
      return before.matricula == after.matricula;
    }

    function camposAlteradosAlunoPermitidos(before, after) {
      return after
        .diff(before)
        .affectedKeys()
        .hasOnly([
          "nome",
          "faixa",
          "ativo",
          "atualizadoEm",
          "atualizadoPor",
          "ultimaOperacaoId"
        ]);
    }

    function metadadosAlunoValidos(after) {
      return after.atualizadoEm == request.time
        && after.atualizadoPor == request.auth.uid
        && after.ultimaOperacaoId is string
        && after.ultimaOperacaoId.size() > 0;
    }


    /*
     * ============================================================
     * Caminhos determinísticos
     * ============================================================
     */

    function eventoIdUsuario(operacaoId, usuarioId) {
      return operacaoId
        + "__USUARIO__"
        + usuarioId;
    }

    function caminhoAuditoriaUsuario(
      operacaoId,
      usuarioId
    ) {
      let eventoId = eventoIdUsuario(
        operacaoId,
        usuarioId
      );

      return /databases/$(database)/documents/auditoriaAdministrativa/$(eventoId);
    }

    function caminhoUsuario(usuarioId) {
      return /databases/$(database)/documents/usuarios/$(usuarioId);
    }


    /*
     * ============================================================
     * Contrato da auditoria administrativa
     * ============================================================
     */

    function auditoriaPossuiCamposObrigatorios(data) {
      return data.keys().hasAll([
          "operacaoId",
          "entidade",
          "entidadeId",
          "acao",
          "autorUid",
          "ocorridoEm",
          "before",
          "after",
          "camposAlterados",
          "contexto",
          "versaoSchema"
        ])
        && data.keys().hasOnly([
          "operacaoId",
          "entidade",
          "entidadeId",
          "acao",
          "autorUid",
          "ocorridoEm",
          "before",
          "after",
          "camposAlterados",
          "contexto",
          "versaoSchema"
        ]);
    }

    function auditoriaPossuiTiposValidos(data) {
      return data.operacaoId is string
        && data.operacaoId.size() > 0
        && data.entidade is string
        && data.entidadeId is string
        && data.entidadeId.size() > 0
        && data.acao is string
        && data.autorUid is string
        && data.ocorridoEm is timestamp
        && (
          data.before == null
          || data.before is map
        )
        && (
          data.after == null
          || data.after is map
        )
        && data.camposAlterados is list
        && (
          data.contexto == null
          || data.contexto is map
        )
        && data.versaoSchema is int;
    }

    function auditoriaUsuarioPossuiValoresControlados(data) {
      return data.entidade == "USUARIO"
        && data.autorUid == request.auth.uid
        && data.ocorridoEm == request.time
        && data.versaoSchema == 1
        && (
          data.acao == "USUARIO_ATUALIZADO"
          || data.acao == "USUARIO_ATIVADO"
          || data.acao == "USUARIO_DESATIVADO"
        );
    }

    function eventoIdUsuarioValido(eventoId, data) {
      return eventoId
        == eventoIdUsuario(
          data.operacaoId,
          data.entidadeId
        );
    }


    /*
     * ============================================================
     * Coerência before / after / camposAlterados
     * ============================================================
     */

    function somenteAtivoAlterado(before, after) {
      return before.ativo != after.ativo
        && before.perfis == after.perfis;
    }

    function somentePerfisAlterados(before, after) {
      return before.ativo == after.ativo
        && before.perfis != after.perfis;
    }

    function ativoEPerfisAlterados(before, after) {
      return before.ativo != after.ativo
        && before.perfis != after.perfis;
    }

    function auditoriaSomenteAtivoValida(
      evento,
      before,
      after
    ) {
      return evento.camposAlterados.size() == 1
        && evento.camposAlterados[0] == "ativo"
        && evento.before is map
        && evento.after is map
        && evento.before.keys().hasOnly([
          "ativo"
        ])
        && evento.before.keys().hasAll([
          "ativo"
        ])
        && evento.after.keys().hasOnly([
          "ativo"
        ])
        && evento.after.keys().hasAll([
          "ativo"
        ])
        && evento.before.ativo == before.ativo
        && evento.after.ativo == after.ativo
        && (
          (
            before.ativo == false
            && after.ativo == true
            && evento.acao == "USUARIO_ATIVADO"
          )
          ||
          (
            before.ativo == true
            && after.ativo == false
            && evento.acao == "USUARIO_DESATIVADO"
          )
        );
    }

    function auditoriaSomentePerfisValida(
      evento,
      before,
      after
    ) {
      return evento.camposAlterados.size() == 1
        && evento.camposAlterados[0] == "perfis"
        && evento.before is map
        && evento.after is map
        && evento.before.keys().hasOnly([
          "perfis"
        ])
        && evento.before.keys().hasAll([
          "perfis"
        ])
        && evento.after.keys().hasOnly([
          "perfis"
        ])
        && evento.after.keys().hasAll([
          "perfis"
        ])
        && evento.before.perfis == before.perfis
        && evento.after.perfis == after.perfis
        && evento.acao == "USUARIO_ATUALIZADO";
    }

    function auditoriaAtivoEPerfisValida(
      evento,
      before,
      after
    ) {
      return evento.camposAlterados.size() == 2
        && evento.camposAlterados.toSet().hasOnly([
          "ativo",
          "perfis"
        ])
        && evento.camposAlterados.toSet().hasAll([
          "ativo",
          "perfis"
        ])
        && evento.before is map
        && evento.after is map
        && evento.before.keys().hasOnly([
          "ativo",
          "perfis"
        ])
        && evento.before.keys().hasAll([
          "ativo",
          "perfis"
        ])
        && evento.after.keys().hasOnly([
          "ativo",
          "perfis"
        ])
        && evento.after.keys().hasAll([
          "ativo",
          "perfis"
        ])
        && evento.before.ativo == before.ativo
        && evento.before.perfis == before.perfis
        && evento.after.ativo == after.ativo
        && evento.after.perfis == after.perfis
        && evento.acao == "USUARIO_ATUALIZADO";
    }

    function auditoriaCoerenteComAlteracao(
      evento,
      before,
      after
    ) {
      return (
          somenteAtivoAlterado(
            before,
            after
          )
          && auditoriaSomenteAtivoValida(
            evento,
            before,
            after
          )
        )
        ||
        (
          somentePerfisAlterados(
            before,
            after
          )
          && auditoriaSomentePerfisValida(
            evento,
            before,
            after
          )
        )
        ||
        (
          ativoEPerfisAlterados(
            before,
            after
          )
          && auditoriaAtivoEPerfisValida(
            evento,
            before,
            after
          )
        );
    }


    /*
     * ============================================================
     * Validação cruzada:
     * usuario UPDATE → auditoria CREATE
     * ============================================================
     */

    function auditoriaCorrespondenteExisteDepois(
      usuarioId,
      before,
      after
    ) {
      let caminho = caminhoAuditoriaUsuario(
        after.ultimaOperacaoId,
        usuarioId
      );

      return !exists(caminho)
        && existsAfter(caminho)
        && auditoriaPossuiCamposObrigatorios(
          getAfter(caminho).data
        )
        && auditoriaPossuiTiposValidos(
          getAfter(caminho).data
        )
        && auditoriaUsuarioPossuiValoresControlados(
          getAfter(caminho).data
        )
        && getAfter(caminho).data.operacaoId
          == after.ultimaOperacaoId
        && getAfter(caminho).data.entidadeId
          == usuarioId
        && auditoriaCoerenteComAlteracao(
          getAfter(caminho).data,
          before,
          after
        );
    }


    /*
     * ============================================================
     * Validação cruzada:
     * auditoria CREATE → usuario UPDATE
     * ============================================================
     */

    function usuarioCorrespondenteFoiAlterado(
      evento
    ) {
      let caminho = caminhoUsuario(
        evento.entidadeId
      );

      return exists(caminho)
        && existsAfter(caminho)
        && alteracaoAdministrativaUsuarioBaseValida(
          evento.entidadeId,
          get(caminho).data,
          getAfter(caminho).data
        )
        && getAfter(caminho).data.ultimaOperacaoId
          == evento.operacaoId
        && auditoriaCoerenteComAlteracao(
          evento,
          get(caminho).data,
          getAfter(caminho).data
        );
    }


    /*
     * ============================================================
     * Usuários
     * ============================================================
     */

    match /usuarios/{usuarioId} {

      /*
       * Leitura própria preservada da Sprint 3.
       * ADMIN ativo pode consultar qualquer usuário.
       */
      allow get: if
        (
          request.auth != null
          && request.auth.uid == usuarioId
        )
        || ehAdmin();

      /*
       * Listagem administrativa exclusiva do ADMIN ativo.
       */
      allow list: if ehAdmin();

      /*
       * S4-003-FB-04B
       *
       * UPDATE administrativo permitido apenas quando:
       *
       * - autor é ADMIN ativo;
       * - somente campos previstos são alterados;
       * - existe alteração real de ativo/perfis;
       * - metadados administrativos são válidos;
       * - autoproteção S4-DEC-003 é respeitada;
       * - auditoria correspondente é criada no mesmo commit.
       */
      allow update: if
        alteracaoAdministrativaUsuarioBaseValida(
          usuarioId,
          resource.data,
          request.resource.data
        )
        && auditoriaCorrespondenteExisteDepois(
          usuarioId,
          resource.data,
          request.resource.data
        );

      /*
       * CREATE será tratado separadamente na FB-05.
       */
      allow create: if false;

      /*
       * Exclusão física regular permanece proibida.
       */
      allow delete: if false;
    }


    /*
     * ============================================================
     * Auditoria Administrativa
     * ============================================================
     */

    match /auditoriaAdministrativa/{eventoId} {

      /*
       * S4-003-FB-04B
       *
       * CREATE permitido somente quando:
       *
       * - autor é ADMIN ativo;
       * - contrato físico do evento é válido;
       * - eventoId é determinístico;
       * - valores controlados são válidos;
       * - usuarios/{uid} correspondente é atualizado
       *   na mesma operação atômica;
       * - before/after/camposAlterados refletem a
       *   alteração real executada.
       */
      allow create: if
        ehAdmin()
        && auditoriaPossuiCamposObrigatorios(
          request.resource.data
        )
        && auditoriaPossuiTiposValidos(
          request.resource.data
        )
        && auditoriaUsuarioPossuiValoresControlados(
          request.resource.data
        )
        && eventoIdUsuarioValido(
          eventoId,
          request.resource.data
        )
        && usuarioCorrespondenteFoiAlterado(
          request.resource.data
        );

      /*
       * Nesta etapa a auditoria não é exposta para leitura.
       */
      allow get, list: if false;

      /*
       * Append-only.
       */
      allow update, delete: if false;
    }


    /*
     * ============================================================
     * Professores — baseline Sprint 3 preservada
     * ============================================================
     */

    match /professores/{professorId} {
      allow read: if possuiAcessoOperacional();
      allow create, update, delete: if false;
    }


    /*
     * ============================================================
     * Alunos — baseline Sprint 3 preservada
     * ============================================================
     */

    match /alunos/{alunoId} {
      allow read: if possuiAcessoOperacional();
      allow create, update, delete: if false;
    }


    /*
     * ============================================================
     * Presenças — baseline Sprint 3 preservada
     * ============================================================
     */

    match /presencas/{presencaId} {

      allow get: if possuiAcessoOperacional();

      allow list: if false;

      allow create: if
        possuiAcessoOperacional()
        && request.resource.data.alunoId is string
        && request.resource.data.professorId is string
        && request.resource.data.matricula is string
        && request.resource.data.nomeAluno is string
        && request.resource.data.nomeProfessor is string
        && request.resource.data.faixa is string
        && request.resource.data.dia is string
        && request.resource.data.origem is string
        && request.resource.data.dataHora == request.time;

      allow update, delete: if false;
    }


    /*
     * ============================================================
     * Negação padrão
     * ============================================================
     */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}